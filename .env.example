# MG Custody — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgres://custody:custody_dev_password@localhost:5432/custody

# API
CUSTODY_API__BIND=0.0.0.0:8443

# HMAC secrets (generate with: openssl rand -hex 32)
CUSTODY_HMAC_SECRET=change_me_in_production
CUSTODY_WEBHOOK_SECRET=change_me_in_production

# Ethereum (Sepolia testnet for development)
CUSTODY_CHAINS__ETHEREUM__RPC_URL=https://rpc.sepolia.org
# For production: use Alchemy/Infura
# CUSTODY_CHAINS__ETHEREUM__RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Bitcoin Core
CUSTODY_CHAINS__BITCOIN__RPC_URL=http://localhost:8332
# CUSTODY_CHAINS__BITCOIN__RPC_USER=bitcoin
# CUSTODY_CHAINS__BITCOIN__RPC_PASSWORD=bitcoin

# Tron
CUSTODY_CHAINS__TRON__API_URL=https://api.trongrid.io

# Solana
CUSTODY_CHAINS__SOLANA__RPC_URL=https://api.mainnet-beta.solana.com

# Compliance (get API keys from providers)
# CHAINALYSIS_API_KEY=your_key
# NOTABENE_API_KEY=your_key

# Logging
RUST_LOG=info,custody=debug
