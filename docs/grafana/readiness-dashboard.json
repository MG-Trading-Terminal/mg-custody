{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping /metrics from mg-custody",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__readme__": "Drop-in Grafana dashboard for mg-custody readiness. Pre-built panels mirror what the /readiness page shows: per-feature state, 24h uptime, probe latency, refresh freshness. Import via Dashboards → Import, pick your Prometheus datasource when prompted. Recording rules are NOT required — every panel uses instant metrics exported by the service.",
  "title": "MG Custody — Feature Readiness",
  "uid": "mg-custody-readiness",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"] },
  "tags": ["mg-custody", "readiness", "sre"],
  "annotations": {
    "list": [
      {
        "name": "Readiness refreshes",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": false,
        "iconColor": "blue",
        "expr": "changes(custody_readiness_last_refresh_seconds[1m]) > 0",
        "step": "1m",
        "titleFormat": "Refresh",
        "tagKeys": ""
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "feature",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(custody_readiness_feature_state, feature)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Features not Ready",
      "description": "Count of features whose current state is Misconfigured or Degraded — i.e. handler-level gates are actively returning 503 for these subsystems. Zero is the healthy state.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "count(custody_readiness_feature_state >= 2) OR vector(0)", "refId": "A", "legendFormat": "broken" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Readiness refresh age",
      "description": "Seconds since the periodic refresh task last rebuilt the report. Alert on > 180s — the task has stopped ticking and the whole live signal is stale.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "time() - custody_readiness_last_refresh_seconds", "refId": "A", "legendFormat": "age" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red",    "value": 180 }
            ]
          },
          "unit": "s"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Probe sweep p99",
      "description": "p99 duration of a full readiness probe sweep over the last 5 minutes. Rising p99 with stable state = vendor latency creep. Noisy on a cold start; give it a minute after deploy.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(custody_readiness_build_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 15 }
            ]
          },
          "unit": "s"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ready features",
      "description": "How many features are in the Ready state right now. Reality check — if this drops sharply without a deploy, you have a real outage.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "count(custody_readiness_feature_state == 1) OR vector(0)", "refId": "A", "legendFormat": "ready" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "none" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Feature state timeline",
      "description": "One line per selected feature. Y values: 0=Disabled, 1=Ready, 2=Misconfigured, 3=Degraded. Alert query: custody_readiness_feature_state >= 2 (anything above the Ready line).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 9 },
      "targets": [
        {
          "expr": "custody_readiness_feature_state{feature=~\"$feature\"}",
          "refId": "A",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "pointSize": 4 },
          "min": 0,
          "max": 3,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISABLED",     "color": "grey"   } } },
            { "type": "value", "options": { "1": { "text": "READY",        "color": "green"  } } },
            { "type": "value", "options": { "2": { "text": "MISCONFIGURED","color": "yellow" } } },
            { "type": "value", "options": { "3": { "text": "DEGRADED",     "color": "red"    } } }
          ]
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Current state per feature",
      "description": "Snapshot of every feature's current state. Red bars = handler gates returning 503.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 10 },
      "targets": [
        { "expr": "custody_readiness_feature_state{feature=~\"$feature\"}", "refId": "A", "legendFormat": "{{feature}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "grey",   "value": null },
              { "color": "green",  "value": 1 },
              { "color": "yellow", "value": 2 },
              { "color": "red",    "value": 3 }
            ]
          },
          "min": 0,
          "max": 3,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISABLED"      } } },
            { "type": "value", "options": { "1": { "text": "READY"         } } },
            { "type": "value", "options": { "2": { "text": "MISCONFIGURED" } } },
            { "type": "value", "options": { "3": { "text": "DEGRADED"      } } }
          ]
        }
      },
      "options": { "displayMode": "lcd", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Probe sweep duration (p50 / p95 / p99)",
      "description": "Latency percentiles of a full probe sweep. All three rising together = a specific vendor is getting slow.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 10 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(custody_readiness_build_duration_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(custody_readiness_build_duration_seconds_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(custody_readiness_build_duration_seconds_bucket[5m])) by (le))", "refId": "C", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 5 }, "unit": "s" } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    }
  ]
}
